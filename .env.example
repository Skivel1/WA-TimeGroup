# Copia este archivo a .env (o define estas variables en Portainer → Stack → Environment variables)
OWNER_NUMBER=5512345678
# Admins fijos opcionales, separados por coma (10 dígitos). Evita depender de WhatsApp Web para permisos
ADMIN_NUMBERS=
# IDs exactos (escribe !id en el grupo para ver el tuyo). Ej: 123456789012345@lid
OWNER_IDS=
# false = solo la lista (owner/admins) usa comandos; el resto se ignora sin responder
PUBLIC_COMMANDS=false
# true (default) = además de la lista, los ADMINS DEL GRUPO de WhatsApp pueden usar los comandos. false = solo la lista
ALLOW_GROUP_ADMINS=true
# IDs exactos o teléfonos, separados por coma. Ej: 123456789012345@lid,525512345678
ADMIN_IDS=
BOT_NAME=Skibot
TZ=America/Mexico_City
LOG_MESSAGES=false
# Reinicio limpio programado (0 = desactivado). Útil si el bot se cuelga tras muchas horas, ej. 24
RESTART_EVERY_HOURS=0
